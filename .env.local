# Future Foods - Local Environment Configuration
# Created: April 2026
# Use this for local development

# ============ API Configuration ============
# Local backend server
VITE_API_BASE_URL=http://localhost:5999/api

# ============ Stripe Configuration ============
# Stripe Test Mode Keys
# These are test keys - replace with your actual Stripe test keys
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890ABCDEFGhijklmnopqrstuvwxyz

# ============ Application Environment ============
VITE_APP_ENV=development

# ============ Feature Flags ============
# Enabled for development
VITE_ENABLE_GUEST_CHECKOUT=true
VITE_ENABLE_SAVED_CARDS=true
VITE_ENABLE_ANALYTICS=false

# ============ Error Tracking (Optional) ============
# Disabled in development
VITE_SENTRY_DSN=

# ============ Analytics (Optional) ============
# Disabled in development
VITE_GA_ID=

# ============ Feature URLs ============
VITE_TERMS_URL=http://localhost:5173/terms
VITE_PRIVACY_URL=http://localhost:5173/privacy
VITE_SUPPORT_URL=http://localhost:3000/support
