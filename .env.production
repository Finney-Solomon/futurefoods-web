# Production Deployment Configuration
# Use this template for production environment

# ============ API Configuration ============
# Production backend server (HTTPS required)
VITE_API_BASE_URL=https://api.futurefoods.com/api

# ============ Stripe Configuration ============
# LIVE MODE KEYS ONLY - Replace with your production keys
# Get from https://dashboard.stripe.com/apikeys
# WARNING: Never commit actual keys to repository!
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY

# ============ Application Environment ============
VITE_APP_ENV=production

# ============ Feature Flags ============
# Disable features not ready for production
VITE_ENABLE_GUEST_CHECKOUT=false
VITE_ENABLE_SAVED_CARDS=true
VITE_ENABLE_ANALYTICS=true

# ============ Error Tracking ============
# Sentry configuration for production error tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============ Analytics ============
# Google Analytics ID for production tracking
VITE_GA_ID=G-XXXXXXXXXX

# ============ Feature URLs ============
VITE_TERMS_URL=https://futurefoods.com/terms
VITE_PRIVACY_URL=https://futurefoods.com/privacy
VITE_SUPPORT_URL=https://support.futurefoods.com

# ============ Security Headers ============
# These should be configured on your web server
# X-Content-Type-Options: nosniff
# X-Frame-Options: DENY
# X-XSS-Protection: 1; mode=block
# Strict-Transport-Security: max-age=31536000; includeSubDomains
# Content-Security-Policy: default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:;

# ============ Cache Control ============
# Configure based on your deployment platform
# Static assets: Cache-Control: public, max-age=31536000
# HTML files: Cache-Control: public, max-age=0, must-revalidate
# API responses: Cache-Control: no-store
