        {
          "name": "❌ Declined Payment - Visa 4000\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"header\": [\n              {\n                \"key\": \"Content-Type\",\n                \"value\": \"application/json\"\n              }\n            ],\n            \"body\": {\n              \"mode\": \"raw\",\n              \"raw\": \"{\n  \\\"cardNumber\\\": \\\"4000 0000 0000 0002\\\",\n  \\\"expiryMonth\\\": \\\"12\\\",\n  \\\"expiryYear\\\": \\\"2026\\\",\n  \\\"cvc\\\": \\\"123\\\",\n  \\\"cardholderName\\\": \\\"Test User\\\",\n  \\\"note\\\": \\\"Card will be declined\\\"\n}\"\n            }\n          }\n        },\n        {\n          \"name\": \"💳 Mastercard 5555\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"header\": [\n              {\n                \"key\": \"Content-Type\",\n                \"value\": \"application/json\"\n              }\n            ],\n            \"body\": {\n              \"mode\": \"raw\",\n              \"raw\": \"{\n  \\\"cardNumber\\\": \\\"5555 5555 5555 4444\\\",\n  \\\"expiryMonth\\\": \\\"12\\\",\n  \\\"expiryYear\\\": \\\"2026\\\",\n  \\\"cvc\\\": \\\"123\\\",\n  \\\"cardholderName\\\": \\\"Test User\\\"\n}\"\n            }\n          }\n        }\n      ]\n    }\n  ],\n  \"variable\": [\n    {\n      \"key\": \"baseUrl\",\n      \"value\": \"http://localhost:5999/api\",\n      \"type\": \"string\"\n    },\n    {\n      \"key\": \"customerToken\",\n      \"value\": \"your_customer_jwt_token_here\",\n      \"type\": \"string\"\n    },\n    {\n      \"key\": \"adminToken\",\n      \"value\": \"your_admin_jwt_token_here\",\n      \"type\": \"string\"\n    },\n    {\n      \"key\": \"productId\",\n      \"value\": \"product_id_from_create_response\",\n      \"type\": \"string\"\n    },\n    {\n      \"key\": \"categoryId\",\n      \"value\": \"category_id_from_create_response\",\n      \"type\": \"string\"\n    },\n    {\n      \"key\": \"orderId\",\n      \"value\": \"order_id_from_create_order_response\",\n      \"type\": \"string\"\n    },\n    {\n      \"key\": \"cartItemId\",\n      \"value\": \"cart_item_id_from_response\",\n      \"type\": \"string\"\n    }\n  ]\n}\n