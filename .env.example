# Future Foods - Environment Configuration
# Copy this file to .env.local and fill in your values

# ============ API Configuration ============
# Backend API Base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5999/api

# ============ Stripe Configuration ============
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# ============ Application Environment ============
# development, production, staging
VITE_APP_ENV=development

# ============ Feature Flags ============
# Enable/disable features for gradual rollout
VITE_ENABLE_GUEST_CHECKOUT=true
VITE_ENABLE_SAVED_CARDS=true
VITE_ENABLE_ANALYTICS=true

# ============ Error Tracking (Optional) ============
# Sentry configuration for error tracking
VITE_SENTRY_DSN=

# ============ Analytics (Optional) ============
# Google Analytics ID
VITE_GA_ID=

# ============ Feature URLs ============
VITE_TERMS_URL=https://futurefoods.com/terms
VITE_PRIVACY_URL=https://futurefoods.com/privacy
VITE_SUPPORT_URL=https://support.futurefoods.com
